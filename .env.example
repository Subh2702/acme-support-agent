# Copy to .env and fill in. Every setting is optional unless marked REQUIRED.
# Secrets are read only from the environment; never commit a real .env.

# --- App ---------------------------------------------------------------------
APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------
# SQLite locally; Postgres in production (postgres:// URLs are normalised automatically).
DATABASE_URL=sqlite:///./data/acme.db
SEED_ON_STARTUP=true                # seed demo customers/orders if the DB is empty

# --- LLM -----------------------------------------------------------------------
# auto = anthropic if LLM_API_KEY is set, else huggingface if HF_TOKEN is set, else ollama.
LLM_PROVIDER=auto                   # auto | ollama | huggingface | anthropic

# Local small model via Ollama (default for local development; costs ₹0).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EVAL_MODEL=                  # simulator/judge model for evals (default: OLLAMA_MODEL)
OLLAMA_NUM_CTX=8192

# Hugging Face Inference Providers router (hosted open models, billed in USD).
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507:cheapest
HF_EVAL_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507:cheapest

# Anthropic.
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium                   # low | medium | high

LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=600
# Optional price override (USD per million tokens) for models without a known price.
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=

# --- Money ---------------------------------------------------------------------
USD_INR_RATE=85                     # providers bill in USD; all costs are shown in ₹
DAILY_BUDGET_INR=300                # global daily LLM budget (IST day); demo pauses when hit

# --- Agent ---------------------------------------------------------------------
AGENT_MAX_ITERATIONS=6
TOOL_TIMEOUT_S=8

# --- RAG -----------------------------------------------------------------------
EMBEDDING_BACKEND=fastembed         # fastembed | hash (hash = tests/CI, no download)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=./data/models
CHROMA_DIR=./data/chroma
RAG_TOP_K=4

# --- Admin & abuse controls ---------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=                     # REQUIRED to enable /admin (disabled when empty)
IP_HASH_SALT=change-me              # client IPs are stored only as salted hashes
RATE_LIMIT_IP_PER_MIN=20
RATE_LIMIT_SESSION_PER_MIN=10
MAX_MESSAGE_CHARS=2000
